{
  "$schema": "http://json.schemastore.org/template",
  "author": "EngBett",
  "classifications": [
    "Web",
    "API",
    "DDD",
    "Clean Architecture"
  ],
  "identity": "EngBett.DDD.Template",
  "name": "DDD .NET Template",
  "shortName": "ddd-template",
  "description": "A .NET 10 Domain-Driven Design (DDD) template with Clean Architecture, CQRS and RabbitMQ messaging both via Wolverine, a .NET Aspire app host, Entity Framework Core (SQL Server, PostgreSQL, SQLite, or MySQL), and optional Minimal APIs or FastEndpoints support.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Template",
  "preferNameDirectory": true,
  "guids": [
    "c48595b9-15cf-4234-bece-ae4b37d4ed78"
  ],
  "symbols": {
    "apiStyle": {
      "type": "parameter",
      "description": "The API style to use: 'controllers' (traditional MVC), 'minimal' (Minimal APIs), or 'fastendpoints' (FastEndpoints library).",
      "datatype": "choice",
      "choices": [
        {
          "choice": "controllers",
          "description": "Traditional MVC controllers (default)"
        },
        {
          "choice": "minimal",
          "description": "ASP.NET Core Minimal APIs"
        },
        {
          "choice": "fastendpoints",
          "description": "FastEndpoints (https://fast-endpoints.com/)"
        }
      ],
      "defaultValue": "controllers"
    },
    "useControllers": {
      "type": "computed",
      "value": "(apiStyle == \"controllers\")"
    },
    "useMinimal": {
      "type": "computed",
      "value": "(apiStyle == \"minimal\")"
    },
    "useFastEndpoints": {
      "type": "computed",
      "value": "(apiStyle == \"fastendpoints\")"
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "shortName": "db",
      "description": "Default relational database provider (EF Core). Can also be set with --postgres, --mysql, --sqlite, or --mssql flags.",
      "choices": [
        {
          "choice": "mssql",
          "description": "Microsoft SQL Server"
        },
        {
          "choice": "postgres",
          "description": "PostgreSQL (Npgsql)"
        },
        {
          "choice": "sqlite",
          "description": "SQLite"
        },
        {
          "choice": "mysql",
          "description": "MySQL (Pomelo)"
        }
      ],
      "defaultValue": "mssql"
    },
    "postgres": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use PostgreSQL (shortcut for --database postgres)."
    },
    "mysql": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use MySQL (shortcut for --database mysql)."
    },
    "sqlite": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use SQLite (shortcut for --database sqlite)."
    },
    "mssql": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use SQL Server (shortcut for --database mssql)."
    },
    "resolvedPostgres": {
      "type": "computed",
      "value": "(postgres || database == \"postgres\")"
    },
    "resolvedMysql": {
      "type": "computed",
      "value": "(mysql || database == \"mysql\")"
    },
    "resolvedSqlite": {
      "type": "computed",
      "value": "(sqlite || database == \"sqlite\")"
    },
    "usePostgres": {
      "type": "computed",
      "value": "resolvedPostgres"
    },
    "useMysql": {
      "type": "computed",
      "value": "(resolvedMysql && !resolvedPostgres)"
    },
    "useSqlite": {
      "type": "computed",
      "value": "(resolvedSqlite && !resolvedPostgres && !resolvedMysql)"
    },
    "useMssql": {
      "type": "computed",
      "value": "(!resolvedPostgres && !resolvedMysql && !resolvedSqlite && (mssql || database == \"mssql\"))"
    }
  },
  "sources": [
    {
      "exclude": [
        "**/*.filelist",
        "**/*.lock.json",
        "**/*.nuspec",
        "**/*.user",
        "**/.vs/**",
        "**/bin/**",
        "**/node_modules/**",
        "**/obj/**",
        ".claude/**",
        ".cursor/**",
        ".git/**",
        ".github/**",
        ".gitignore",
        ".idea/**",
        ".template.config/**",
        ".vs/**",
        "AGENT.md",
        "AGENTS.md",
        "CLAUDE.md",
        "README.md",
        "global.json"
      ],
      "modifiers": [
        {
          "condition": "(useControllers)",
          "rename": {
            "src/Template.Api/Program.Controllers.cs": "src/Template.Api/Program.cs",
            "src/Template.Api/Template.Api.Controllers.csproj": "src/Template.Api/Template.Api.csproj"
          },
          "exclude": [
            "src/Template.Api/Program.cs",
            "src/Template.Api/Program.Minimal.cs",
            "src/Template.Api/Program.FastEndpoints.cs",
            "src/Template.Api/Template.Api.Minimal.csproj",
            "src/Template.Api/Template.Api.FastEndpoints.csproj",
            "src/Template.Api/FastEndpoints/**",
            "src/Template.Api/MinimalApiEndpoints/**"
          ]
        },
        {
          "condition": "(useMinimal)",
          "rename": {
            "src/Template.Api/Program.Minimal.cs": "src/Template.Api/Program.cs",
            "src/Template.Api/Template.Api.Minimal.csproj": "src/Template.Api/Template.Api.csproj"
          },
          "exclude": [
            "src/Template.Api/Program.cs",
            "src/Template.Api/Program.Controllers.cs",
            "src/Template.Api/Program.FastEndpoints.cs",
            "src/Template.Api/Template.Api.csproj",
            "src/Template.Api/Template.Api.Controllers.csproj",
            "src/Template.Api/Template.Api.FastEndpoints.csproj",
            "src/Template.Api/FastEndpoints/**",
            "src/Template.Api/Controllers/**"
          ]
        },
        {
          "condition": "(useFastEndpoints)",
          "rename": {
            "src/Template.Api/Program.FastEndpoints.cs": "src/Template.Api/Program.cs",
            "src/Template.Api/Template.Api.FastEndpoints.csproj": "src/Template.Api/Template.Api.csproj"
          },
          "exclude": [
            "src/Template.Api/Program.cs",
            "src/Template.Api/Program.Controllers.cs",
            "src/Template.Api/Program.Minimal.cs",
            "src/Template.Api/Template.Api.csproj",
            "src/Template.Api/Template.Api.Controllers.csproj",
            "src/Template.Api/Template.Api.Minimal.csproj",
            "src/Template.Api/MinimalApiEndpoints/**",
            "src/Template.Api/Controllers/**"
          ]
        },
        {
          "condition": "(useMssql)",
          "exclude": [
            "src/Template.Api/appsettings.Database.postgres.json",
            "src/Template.Api/appsettings.Database.sqlite.json",
            "src/Template.Api/appsettings.Database.mysql.json"
          ]
        },
        {
          "condition": "(usePostgres)",
          "rename": {
            "src/Template.Api/appsettings.Database.postgres.json": "src/Template.Api/appsettings.json"
          },
          "exclude": [
            "src/Template.Api/appsettings.json",
            "src/Template.Api/appsettings.Database.sqlite.json",
            "src/Template.Api/appsettings.Database.mysql.json"
          ]
        },
        {
          "condition": "(useSqlite)",
          "rename": {
            "src/Template.Api/appsettings.Database.sqlite.json": "src/Template.Api/appsettings.json"
          },
          "exclude": [
            "src/Template.Api/appsettings.json",
            "src/Template.Api/appsettings.Database.postgres.json",
            "src/Template.Api/appsettings.Database.mysql.json"
          ]
        },
        {
          "condition": "(useMysql)",
          "rename": {
            "src/Template.Api/appsettings.Database.mysql.json": "src/Template.Api/appsettings.json"
          },
          "exclude": [
            "src/Template.Api/appsettings.json",
            "src/Template.Api/appsettings.Database.postgres.json",
            "src/Template.Api/appsettings.Database.sqlite.json"
          ]
        }
      ]
    }
  ]
}
