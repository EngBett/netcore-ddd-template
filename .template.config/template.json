{
  "$schema": "http://json.schemastore.org/template",
  "author": "EngBett",
  "classifications": [
    "Web",
    "API",
    "DDD",
    "Clean Architecture"
  ],
  "identity": "EngBett.DDD.Template",
  "name": "DDD .NET Template",
  "shortName": "ddd-template",
  "description": "A .NET 10 Domain-Driven Design (DDD) template with Clean Architecture, MediatR, Entity Framework Core (SQL Server, PostgreSQL, SQLite, or MySQL), and optional Minimal APIs or FastEndpoints support.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Template",
  "preferNameDirectory": true,
  "symbols": {
    "apiStyle": {
      "type": "parameter",
      "description": "The API style to use: 'controllers' (traditional MVC), 'minimal' (Minimal APIs), or 'fastendpoints' (FastEndpoints library).",
      "datatype": "choice",
      "choices": [
        {
          "choice": "controllers",
          "description": "Traditional MVC controllers (default)"
        },
        {
          "choice": "minimal",
          "description": "ASP.NET Core Minimal APIs"
        },
        {
          "choice": "fastendpoints",
          "description": "FastEndpoints (https://fast-endpoints.com/)"
        }
      ],
      "defaultValue": "controllers"
    },
    "useControllers": {
      "type": "computed",
      "value": "(apiStyle == \"controllers\")"
    },
    "useMinimal": {
      "type": "computed",
      "value": "(apiStyle == \"minimal\")"
    },
    "useFastEndpoints": {
      "type": "computed",
      "value": "(apiStyle == \"fastendpoints\")"
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "shortName": "db",
      "description": "Default relational database provider (EF Core). Can also be set with --postgres, --mysql, --sqlite, or --mssql flags.",
      "choices": [
        {
          "choice": "mssql",
          "description": "Microsoft SQL Server"
        },
        {
          "choice": "postgres",
          "description": "PostgreSQL (Npgsql)"
        },
        {
          "choice": "sqlite",
          "description": "SQLite"
        },
        {
          "choice": "mysql",
          "description": "MySQL (Pomelo)"
        }
      ],
      "defaultValue": "mssql"
    },
    "postgres": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use PostgreSQL (shortcut for --database postgres)."
    },
    "mysql": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use MySQL (shortcut for --database mysql)."
    },
    "sqlite": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use SQLite (shortcut for --database sqlite)."
    },
    "mssql": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use SQL Server (shortcut for --database mssql)."
    },
    "resolvedPostgres": {
      "type": "computed",
      "value": "(postgres || database == \"postgres\")"
    },
    "resolvedMysql": {
      "type": "computed",
      "value": "(mysql || database == \"mysql\")"
    },
    "resolvedSqlite": {
      "type": "computed",
      "value": "(sqlite || database == \"sqlite\")"
    },
    "usePostgres": {
      "type": "computed",
      "value": "resolvedPostgres"
    },
    "useMysql": {
      "type": "computed",
      "value": "(resolvedMysql && !resolvedPostgres)"
    },
    "useSqlite": {
      "type": "computed",
      "value": "(resolvedSqlite && !resolvedPostgres && !resolvedMysql)"
    },
    "useMssql": {
      "type": "computed",
      "value": "(!resolvedPostgres && !resolvedMysql && !resolvedSqlite && (mssql || database == \"mssql\"))"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(useControllers)",
          "rename": {
            "Template.Api/Program.Controllers.cs": "Template.Api/Program.cs",
            "Template.Api/Template.Api.Controllers.csproj": "Template.Api/Template.Api.csproj"
          },
          "exclude": [
            "Template.Api/Program.cs",
            "Template.Api/Program.Minimal.cs",
            "Template.Api/Program.FastEndpoints.cs",
            "Template.Api/Template.Api.Minimal.csproj",
            "Template.Api/Template.Api.FastEndpoints.csproj",
            "Template.Api/Endpoints/**",
            "Template.Api/MinimalApiEndpoints/**"
          ]
        },
        {
          "condition": "(useMinimal)",
          "rename": {
            "Template.Api/Program.Minimal.cs": "Template.Api/Program.cs",
            "Template.Api/Template.Api.Minimal.csproj": "Template.Api/Template.Api.csproj"
          },
          "exclude": [
            "Template.Api/Program.cs",
            "Template.Api/Program.Controllers.cs",
            "Template.Api/Program.FastEndpoints.cs",
            "Template.Api/Template.Api.csproj",
            "Template.Api/Template.Api.Controllers.csproj",
            "Template.Api/Template.Api.FastEndpoints.csproj",
            "Template.Api/Endpoints/**",
            "Template.Api/Controllers/**"
          ]
        },
        {
          "condition": "(useFastEndpoints)",
          "rename": {
            "Template.Api/Program.FastEndpoints.cs": "Template.Api/Program.cs",
            "Template.Api/Template.Api.FastEndpoints.csproj": "Template.Api/Template.Api.csproj"
          },
          "exclude": [
            "Template.Api/Program.cs",
            "Template.Api/Program.Controllers.cs",
            "Template.Api/Program.Minimal.cs",
            "Template.Api/Template.Api.csproj",
            "Template.Api/Template.Api.Controllers.csproj",
            "Template.Api/Template.Api.Minimal.csproj",
            "Template.Api/MinimalApiEndpoints/**",
            "Template.Api/Controllers/**"
          ]
        },
        {
          "condition": "(useMssql)",
          "exclude": [
            "Template.Api/appsettings.Database.postgres.json",
            "Template.Api/appsettings.Database.sqlite.json",
            "Template.Api/appsettings.Database.mysql.json"
          ]
        },
        {
          "condition": "(usePostgres)",
          "rename": {
            "Template.Api/appsettings.Database.postgres.json": "Template.Api/appsettings.json"
          },
          "exclude": [
            "Template.Api/appsettings.json",
            "Template.Api/appsettings.Database.sqlite.json",
            "Template.Api/appsettings.Database.mysql.json"
          ]
        },
        {
          "condition": "(useSqlite)",
          "rename": {
            "Template.Api/appsettings.Database.sqlite.json": "Template.Api/appsettings.json"
          },
          "exclude": [
            "Template.Api/appsettings.json",
            "Template.Api/appsettings.Database.postgres.json",
            "Template.Api/appsettings.Database.mysql.json"
          ]
        },
        {
          "condition": "(useMysql)",
          "rename": {
            "Template.Api/appsettings.Database.mysql.json": "Template.Api/appsettings.json"
          },
          "exclude": [
            "Template.Api/appsettings.json",
            "Template.Api/appsettings.Database.postgres.json",
            "Template.Api/appsettings.Database.sqlite.json"
          ]
        }
      ]
    }
  ]
}
