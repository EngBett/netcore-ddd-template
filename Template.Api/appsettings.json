{
  "DatabaseKind": "mssql",
  "DATABASE_CON": "Server=localhost,1433;Database=Template.Api;User Id=sa;Password=Password@123;TrustServerCertificate=True;",
  "ApplicationOptions": {
    "LogUrl": "http://localhost:5341",
    "Authority": "",
    "Audience": "/resources",
    "Queue": "",
    "ClientId": "",
    "ClientSecret": "secret",
    "SensitiveDataKeys": "pan,authorization,secret,cookie,refresh_token,refreshtoken,securedata,pin,token,password,access_token,file",
    "SensitiveDataDefaultValues": "pan,authorization,secret,cookie,refresh_token,refreshtoken,securedata,pin,token,password,access_token,file",
    "EnableAutoMigration": true,
    "UseLoggerMiddleWare": true,
    "RequireHttpsMetadata": true,
    "MetadataAddress": "/.well-known/openid-configuration"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMQOptions": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "RedisOptions": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "Template.Api"
  },
  "MassTransitOptions": {
    "EnableInMemoryOutbox": true,
    "RetryIntervalsMilliseconds": [ 100, 500, 1000 ],
    "EnableDelayedRedelivery": true,
    "RedeliveryIntervalsSeconds": [ 1, 5, 15 ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
