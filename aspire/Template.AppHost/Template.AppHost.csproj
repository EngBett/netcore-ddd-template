<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.4" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAspireHost>true</IsAspireHost>
        <!-- ASPIRE010 advertises the Aspire CLI bundle. This AppHost is run with plain
             `dotnet run`, which needs no bundle and is what the README documents, so the
             advice does not apply. Setting AspireUseCliBundle=true instead makes
             `dotnet run` delegate to the CLI, which then has to resolve and launch the
             bundle before the host starts. -->
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
        <!-- Aspire persists the credentials it generates for containers in user secrets.
             Without a stable id they would be regenerated on every run and would no
             longer match the passwords already baked into the data volumes below. -->
        <UserSecretsId>c48595b9-15cf-4234-bece-ae4b37d4ed78</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.4" />
        <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.5.4" />
        <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.4" />
        <PackageReference Include="Aspire.Hosting.Seq" Version="13.5.4" />
        <!--#if (useMssql)-->
        <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.4" />
        <!--#endif-->
        <!--#if (usePostgres)-->
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
        <!--#endif-->
        <!--#if (useMysql)-->
        <PackageReference Include="Aspire.Hosting.MySql" Version="13.5.4" />
        <!--#endif-->
    </ItemGroup>

    <ItemGroup>
        <!-- Builds the service before the AppHost runs it. The resource itself is added
             by path in Program.cs rather than through the generated Projects.* class,
             because `dotnet new` rewrites "Template" to the chosen project name and
             would turn Projects.Template_Api into an invalid identifier. -->
        <ProjectReference Include="..\..\src\Template.Api\Template.Api.csproj" />
    </ItemGroup>

</Project>
