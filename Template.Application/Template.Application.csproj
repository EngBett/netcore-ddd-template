<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.0.0" />
        <!-- Wolverine replaces BOTH MediatR (in-process CQRS via IMessageBus.InvokeAsync)
             and MassTransit (broker messaging over RabbitMQ). WolverineFx and its
             extensions are MIT, so no version range pin is needed the way MassTransit's
             was to stay off the 9.x proprietary licence.
             RuntimeCompilation is NOT optional: from 6.x core WolverineFx no longer
             ships the Roslyn runtime compiler, and without it the host throws on
             startup under the default TypeLoadMode.Dynamic. The alternative is
             pre-generating code (the `codegen write` CLI command) plus
             TypeLoadMode.Static, which is a deployment step a template cannot assume. -->
        <PackageReference Include="WolverineFx" Version="6.40.0" />
        <PackageReference Include="WolverineFx.RabbitMQ" Version="6.40.0" />
        <PackageReference Include="WolverineFx.FluentValidation" Version="6.40.0" />
        <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.40.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Template.Common\Template.Common.csproj" />
        <ProjectReference Include="..\Template.Domain\Template.Domain.csproj" />
    </ItemGroup>
    
</Project>
